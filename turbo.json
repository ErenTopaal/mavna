{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:live": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "publish:check": {
      "dependsOn": ["build"]
    },
    "size": {
      "dependsOn": ["build"],
      "inputs": ["dist/**", "package.json"]
    }
  }
}
