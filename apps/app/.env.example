# Copy to .env.local. Vite only exposes variables prefixed VITE_ to the browser,
# and everything here is public by definition: it ships in the bundle.

# testnet or mainnet: the network the app starts on.
VITE_MAVNA_NETWORK=testnet

# The Stellar node and sponsor for that network. Optional: testnet defaults to
# the foundation's public node, mainnet to the first of the measured public
# nodes (the foundation runs none), and the sponsor to http://localhost:8787.
VITE_STELLAR_RPC_URL=
VITE_MAVNA_SPONSOR_URL=

# Networks the header toggle switches between, comma separated, the one above
# among them. Defaults to only that one. Every other network listed needs its
# own sponsor below, since a sponsor serves one network.
VITE_MAVNA_NETWORKS=
VITE_MAVNA_TESTNET_RPC_URL=
VITE_MAVNA_TESTNET_SPONSOR_URL=
VITE_MAVNA_MAINNET_RPC_URL=
VITE_MAVNA_MAINNET_SPONSOR_URL=

# Route sources to take out of rotation, comma separated, as `id:reason`.
# The reason is shown to users, so write it for them:
#   VITE_MAVNA_DISABLED_SOURCES=cctp:Circle is not available right now
# Leave empty to route through everything.
VITE_MAVNA_DISABLED_SOURCES=
