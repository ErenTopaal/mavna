{
  "$schema": "https://turbo.build/schema.json",
  "//": "Inlined at build time, so a cached build made for another sponsor is never served.",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["MAVNA_BROWSER_HARNESS", "MAVNA_BUILD_OUT_DIR", "VITE_MAVNA_*"],
      "outputs": ["dist/**", "dist-test/**"]
    }
  }
}
