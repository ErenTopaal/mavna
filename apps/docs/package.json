{
  "name": "@mavna/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-reference.mjs && react-router dev",
    "build": "node scripts/sync-reference.mjs && react-router build",
    "build:test": "node scripts/sync-reference.mjs && MAVNA_BUILD_OUT_DIR=dist-test react-router build",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "node scripts/sync-reference.mjs && react-router typegen && tsc --noEmit",
    "test": "vitest run --project unit --root ../.. apps/docs",
    "sync:reference": "node scripts/sync-reference.mjs",
    "example:quote": "node examples/quote.ts"
  },
  "dependencies": {
    "@fontsource/azeret-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@mavna/adapter-axelar": "workspace:*",
    "@mavna/adapter-cctp": "workspace:*",
    "@mavna/adapter-layerzero": "workspace:*",
    "@mavna/adapter-near-intents": "workspace:*",
    "@mavna/core": "workspace:*",
    "@mavna/routing": "workspace:*",
    "@mavna/status": "workspace:*",
    "@mavna/stellar": "workspace:*",
    "@mavna/widget": "workspace:*",
    "@react-router/node": "8.5.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.8",
    "fumadocs-ui": "16.17.7",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}
