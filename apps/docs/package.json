{
  "name": "@mavna/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-reference.mjs && next dev",
    "build": "node scripts/sync-reference.mjs && next build && pagefind --site .next/server/app --output-path public/_pagefind",
    "build:test": "node scripts/sync-reference.mjs && MAVNA_NEXT_DIST_DIR=.next-test next build",
    "start": "next start",
    "typecheck": "node scripts/sync-reference.mjs && tsc --noEmit",
    "test": "vitest run --project unit --root ../.. apps/docs",
    "sync:reference": "node scripts/sync-reference.mjs",
    "example:quote": "node examples/quote.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@mavna/adapter-axelar": "workspace:*",
    "@mavna/adapter-cctp": "workspace:*",
    "@mavna/adapter-layerzero": "workspace:*",
    "@mavna/adapter-near-intents": "workspace:*",
    "@mavna/core": "workspace:*",
    "@mavna/routing": "workspace:*",
    "@mavna/status": "workspace:*",
    "@mavna/stellar": "workspace:*",
    "@mavna/widget": "workspace:*",
    "next": "16.4.2",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  }
}
