{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["astro/client"],
    "noEmit": true,
    // A site emits pages, not declarations. Leaving declaration emit on made
    // `content.config.ts` fail on a type it cannot name from inside Starlight,
    // which is a real constraint on a published package and nothing at all here.
    "isolatedDeclarations": false,
    "declaration": false,
    "allowJs": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "examples/**/*.ts",
    "astro.config.mjs"
  ]
}
