{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // a site emits pages, not declarations. the base config's declaration
    // settings exist for published packages and mean nothing here.
    "isolatedDeclarations": false,
    "declaration": false,
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "@/*": ["./app/*"] }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "*.ts",
    ".react-router/types/**/*"
  ],
  "exclude": ["node_modules"]
}
