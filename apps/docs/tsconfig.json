{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["es2023", "dom", "dom.iterable"],
    "noEmit": true,
    // A site emits pages, not declarations. The base config's declaration
    // settings exist for published packages and mean nothing here.
    "isolatedDeclarations": false,
    "declaration": false,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "mdx-components.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
