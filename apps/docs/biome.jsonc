{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    // A nested config replaces the root's file list rather than adding to it, so
    // the root's exclusions are repeated here. The additions are react router's
    // generated route types and the reference tables this package writes from the
    // packages' own source before every build. MDX is content, not code the
    // linter reads.
    "includes": [
      "**",
      "!dist",
      "!dist-test",
      "!.turbo",
      "!.react-router",
      "!node_modules",
      "!generated",
      "!**/*.md",
      "!**/*.mdx",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        // The runnable example prints its quote, the reference generator prints
        // what it wrote, and the static server says where it listens. All are
        // command line programs whose output is the point of running them.
        "noConsole": "off"
      }
    }
  }
}
