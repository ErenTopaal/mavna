{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    // A nested config replaces the root's file list rather than adding to it, so
    // the root's exclusions are repeated here. The additions are Next's build
    // output and the reference tables this package writes from the packages' own
    // source before every build. MDX is content, not code the linter reads.
    "includes": [
      "**",
      "!dist",
      "!.next",
      "!.turbo",
      "!node_modules",
      "!generated",
      "!next-env.d.ts",
      "!public/_pagefind",
      "!**/*.md",
      "!**/*.mdx",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        // The runnable example prints its quote and the reference generator
        // prints what it wrote. Both are command line programs whose output is
        // the entire point of running them.
        "noConsole": "off"
      }
    }
  }
}
