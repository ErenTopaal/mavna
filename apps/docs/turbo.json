{
  "$schema": "https://turbo.build/schema.json",
  "//": "Inlined at build time, so a cached build made for another sponsor is never served.",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["MAVNA_NEXT_DIST_DIR", "NEXT_PUBLIC_MAVNA_*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".next-test/**",
        "!.next-test/cache/**",
        "public/_pagefind/**"
      ]
    }
  }
}
