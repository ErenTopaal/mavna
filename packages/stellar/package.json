{
  "name": "@mavna/stellar",
  "version": "0.1.0",
  "description": "Stellar RPC client, address and destination checks, reserves and sponsorship transactions for Mavna.",
  "keywords": [
    "stellar",
    "soroban"
  ],
  "homepage": "https://docs.mavna.app/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErenTopaal/mavna.git",
    "directory": "packages/stellar"
  },
  "bugs": {
    "url": "https://github.com/ErenTopaal/mavna/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --project unit --passWithNoTests --root ../.. packages/stellar",
    "publish:check": "publint --strict && attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "dependencies": {
    "@mavna/core": "workspace:*",
    "@stellar/stellar-sdk": "17.2.1"
  }
}
