{
  "name": "@mavna/swap",
  "version": "0.0.0",
  "description": "Stellar exchanges (Soroswap, SushiSwap, Aquarius and the order book) behind one interface, for Mavna.",
  "keywords": [
    "stellar",
    "swap",
    "dex"
  ],
  "homepage": "https://docs.mavna.app/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErenTopaal/mavna.git",
    "directory": "packages/swap"
  },
  "bugs": {
    "url": "https://github.com/ErenTopaal/mavna/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --project unit --passWithNoTests --root ../.. packages/swap",
    "publish:check": "publint --strict && attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "dependencies": {
    "@mavna/core": "workspace:*",
    "@mavna/stellar": "workspace:*",
    "@stellar/stellar-sdk": "17.2.1",
    "zod": "4.6.7"
  }
}
