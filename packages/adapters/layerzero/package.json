{
  "name": "@mavna/adapter-layerzero",
  "version": "0.1.0",
  "description": "LayerZero OFT as a Mavna rail: USDT0 to Stellar.",
  "keywords": [
    "stellar",
    "layerzero",
    "usdt0",
    "bridge"
  ],
  "homepage": "https://docs.mavna.app/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErenTopaal/mavna.git",
    "directory": "packages/adapters/layerzero"
  },
  "bugs": {
    "url": "https://github.com/ErenTopaal/mavna/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --project unit --passWithNoTests --root ../../.. packages/adapters/layerzero",
    "publish:check": "publint --strict && attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "dependencies": {
    "@mavna/core": "workspace:*",
    "@mavna/routing": "workspace:*",
    "@mavna/stellar": "workspace:*",
    "@stellar/stellar-sdk": "17.2.1",
    "viem": "2.57.7"
  }
}
