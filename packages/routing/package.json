{
  "name": "@mavna/routing",
  "version": "0.1.0",
  "description": "Asks every Mavna rail at once and ranks the routes by what arrives on Stellar.",
  "keywords": [
    "stellar",
    "bridge",
    "routing"
  ],
  "homepage": "https://docs.mavna.app/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErenTopaal/mavna.git",
    "directory": "packages/routing"
  },
  "bugs": {
    "url": "https://github.com/ErenTopaal/mavna/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --project unit --passWithNoTests --root ../.. packages/routing",
    "publish:check": "publint --strict && attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "dependencies": {
    "@mavna/core": "workspace:*"
  }
}
