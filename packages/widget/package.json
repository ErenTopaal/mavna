{
  "name": "@mavna/widget",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
    "./widget.css": "./dist/widget.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --root ../..",
    "size": "size-limit",
    "publish:check": "publint --strict && attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "peerDependencies": { "react": ">=19" },
  "dependencies": { "@mavna/core": "workspace:*" },
  "devDependencies": {
    "@size-limit/preset-small-lib": "13.0.3",
    "@tsdown/css": "0.22.14",
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "size-limit": "13.0.3"
  },
  "size-limit": [{ "path": "dist/index.mjs", "limit": "12 kB", "ignore": ["react"] }]
}
