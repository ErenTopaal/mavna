{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.turbo",
      "!**/.claude",
      "!**/node_modules",
      "!**/test-results",
      "!**/playwright-report",
      "!tests/fixtures",
      "!**/.probe-*",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml",
      "!contracts/**/target",
      "!contracts/**/test_snapshots"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/**/src/**",
        "!packages/**/src/**/*.test.ts",
        "!packages/**/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "Buffer is a Node global that browsers do not have, and the packages run in browsers. Use Uint8Array with TextEncoder or TextDecoder, or the Buffer an SDK itself exports when its API demands one."
                }
              }
            }
          }
        }
      }
    }
  ]
}
