{
  "name": "mavna",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^24.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:live": "turbo run test:live",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && oxlint --type-aware && node scripts/check-exports.mjs",
    "lint:fix": "biome check --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "publish:check": "turbo run publish:check",
    "check:exports": "node scripts/check-exports.mjs",
    "test:browser": "playwright test",
    "size": "turbo run size",
    "test:browser:live": "MAVNA_LIVE=1 playwright test --grep-invert '^$' tests/transfer.live.spec.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.62.1",
    "@solana/addresses": "7.0.0",
    "@types/node": "26.2.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "turbo": "2.10.9",
    "typescript": "7.0.2",
    "viem": "2.55.13",
    "vitest": "4.1.10"
  }
}
