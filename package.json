{
  "name": "mavna",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.22.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test test:scripts",
    "test:scripts": "vitest run --project unit scripts",
    "test:live": "turbo run test:live",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && oxlint --type-aware && node scripts/check-exports.mjs",
    "lint:fix": "biome check --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "publish:check": "turbo run publish:check",
    "check:exports": "node scripts/check-exports.mjs",
    "test:browser": "playwright test",
    "size": "turbo run size"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.64.1",
    "@solana/addresses": "7.0.0",
    "@types/node": "26.6.5",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsdown": "0.22.14",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "viem": "2.57.7",
    "vitest": "4.1.10"
  }
}
