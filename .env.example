# Copy to .env and fill in. .env is gitignored and must never be committed.
# These are the variables docker-compose.yml reads to run the app and sponsor.

# Which network everything runs on: testnet or mainnet. Defaults to testnet.
MAVNA_NETWORK=testnet

# Stellar RPC endpoint for that network. Left empty, testnet uses the
# foundation's public node and mainnet the first of the measured public nodes in
# @mavna/stellar (the foundation runs none on mainnet). Set your own provider
# when you have one.
# Left empty here so the default follows MAVNA_NETWORK; the sponsor refuses to
# start against a node that serves the other network.
STELLAR_RPC_URL=

# Sponsor account that fronts account and trustline reserves for arriving users.
# Operational secret. Never in the repo, a client bundle, or a log line. docker
# compose refuses to start the sponsor without it.
SPONSOR_SECRET_KEY=

# Browser origins allowed to call the sponsor, comma separated. Never "*": the
# sponsor spends money on request. Defaults to the app's dev origin.
MAVNA_ALLOWED_ORIGINS=http://localhost:4319

# How often, in seconds, the sponsor retries held settlements nobody's page came
# back for (LayerZero and Axelar deliveries whose tab closed). 0 turns it off.
# Defaults to 120.
MAVNA_SETTLE_SWEEP_SECONDS=

# Who pays a new account's reserve. sponsor (default): the sponsor fronts it and
# is repaid from what arrives. self: a temporary switch for running without a
# funded sponsor key; an existing account opens its own trustline from its own
# XLM, and an address that does not exist yet is declined at quote time, since
# it would need XLM sent to it first. The receiving account also signs and pays
# Circle's delivery on Stellar and runs an overdue conversion on arrival
# (lz_compose) from its own wallet; /deliver and /compose answer 409, so the
# sponsor spends nothing. It still needs SPONSOR_SECRET_KEY to start.
MAVNA_RESERVE_FUNDING=sponsor

# Where the sponsor keeps its caps, held settlements and channel keys. Holds
# secret keys: keep it private. docker compose uses a named volume at
# /var/lib/mavna. Unset outside compose, all of it lives in memory and is lost
# on restart.
MAVNA_STATE_DIR=

# true for a sponsor serving real users on testnet; mainnet always counts. A
# production sponsor refuses to start without MAVNA_STATE_DIR.
MAVNA_PRODUCTION=

# Daily caps. Defaults: 75 strandings, 300 sponsorships from expensive-gas
# chains, 200 from cheap-gas chains. The source chain is only the caller's
# claim, so every sponsorship counts against the smaller of the two.
MAVNA_CAP_STRANDING_PER_DAY=
MAVNA_CAP_VOLUME_EXPENSIVE_PER_DAY=
MAVNA_CAP_VOLUME_CHEAP_PER_DAY=

# The smallest Circle mint, in USDC, the sponsor pays to deliver. Defaults to 1.
MAVNA_MIN_DELIVERY_USDC=
# Delivery fees the sponsor may pay in one UTC day, in XLM. Past it, /deliver
# answers 503 until the next day. Defaults to 25; 0 pays for none.
MAVNA_DELIVERY_BUDGET_XLM=

# Requests per client address per minute on every sponsor endpoint. Defaults to
# 120; 0 turns it off. Set MAVNA_TRUST_PROXY=true only behind a reverse proxy
# that appends the client address to X-Forwarded-For.
MAVNA_RATE_LIMIT_PER_MINUTE=
MAVNA_TRUST_PROXY=

# Settlements nothing has backed yet that may hold a channel at once, across
# every client, each for ten minutes at most. With the daily caps this sizes the
# channel pool the sponsor funds for itself (2 XLM each, only as they are
# needed): twice the smaller daily volume cap plus this. Defaults to 16.
MAVNA_PROVISIONAL_SETTLEMENTS=
# Settlements one client address may have waiting on a preparation at once.
# Defaults to 2; 0 turns the limit off.
MAVNA_SETTLEMENTS_PER_CLIENT=

# The sponsor URL the app calls. Defaults to the local sponsor above.
MAVNA_SPONSOR_URL=http://localhost:8787

# Networks the app's toggle switches between, comma separated, MAVNA_NETWORK
# among them. Defaults to MAVNA_NETWORK only. Every other network listed needs
# its own sponsor URL, since a sponsor serves one network.
MAVNA_NETWORKS=
MAVNA_TESTNET_RPC_URL=
MAVNA_TESTNET_SPONSOR_URL=
MAVNA_MAINNET_RPC_URL=
MAVNA_MAINNET_SPONSOR_URL=

# Rails to take out of rotation, comma separated, as "id:reason". The reason is
# shown to users, so write it for them, for example:
#   MAVNA_DISABLED_SOURCES=cctp:Circle is not available right now
# Optional; empty means every rail is live.
MAVNA_DISABLED_SOURCES=

# Soroswap swap API key, read by the sponsor service, which proxies Soroswap at
# /swap/soroswap/* so the key never reaches a browser. Server-side secret.
# Optional; without it the swap leg uses SushiSwap (USDT0 pairs) and Aquarius.
SOROSWAP_API_KEY=

# The Mavna Arrival Contract whose overdue conversions this sponsor finishes at
# /compose, and kept alive daily. Optional; unset, /compose finishes nothing. The
# widget has its own per-network setting (testnet defaults to the deployed one).
# In self mode it is neither finished nor kept alive here (/compose answers 409),
# so the sponsor spends nothing; whoever finishes pays any storage renewal due.
MAVNA_ARRIVAL_CONTRACT=

# Required with MAVNA_ARRIVAL_CONTRACT in sponsor mode: a separate key named as lz_compose's
# executor, never the sponsor key. It signs only that authorization and holds
# only its 1 XLM minimum, created on first use. Server-side secret.
MAVNA_ARRIVAL_EXECUTOR_SECRET=
