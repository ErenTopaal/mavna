# Copy to .env and fill in. .env is gitignored and must never be committed.

# Soroswap swap API. Server-side secret: this key must never reach a browser bundle.
SOROSWAP_API_KEY=

# Sponsor account that fronts account and trustline reserves for arriving users.
# Operational secret. Not in the repo, not in client bundles, not in logs.
SPONSOR_SECRET_KEY=

# Stellar RPC. Testnet has a public endpoint; mainnet has none run by the foundation,
# so a provider must be chosen and configured before mainnet.
STELLAR_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
STELLAR_RPC_URL_MAINNET=
